    {
      "parameters": {
        "jsCode": "// Aplana el maestro-detalle de Symphony y hace UPSERT (solo IDs nuevos se agregan)\nconst rows = $('Leer hoja Compras').all().map(i => i.json);\nlet existentes = new Set();\ntry { existentes = new Set($('Leer compras ya cargadas').all().map(i => parseInt(i.json.ID_COMPRA)).filter(Boolean)); }\ncatch (e) { /* pestaña vacía: tratar todo como nuevo */ }\nlet detExistentes = new Set();\ntry { detExistentes = new Set($('Leer detalle ya cargado').all().map(i => parseInt(i.json.ID_COMPRA)).filter(Boolean)); } catch (e) {}\nlet provExistentes = new Set();\ntry { provExistentes = new Set($('Leer proveedores ya generados').all().map(i => parseInt(i.json.ID_COMPRA)).filter(Boolean)); } catch (e) {}\nconst NIT_PROPIO = '900570024';\nconst num = v => { const n = parseFloat(v); return isNaN(n) ? 0 : n; };\nconst cab = []; const det = []; const provLoc = {};\nlet idActual = null; let lineasPorId = {};\nfor (const r of rows) {\n  const tieneId = r.Id !== null && r.Id !== undefined && String(r.Id).trim() !== '';\n  if (tieneId) idActual = parseInt(r.Id);\n  if (!idActual) continue;\n  const esFilaProducto = r.Productos !== null && r.Productos !== undefined && String(r.Productos).trim() !== '' && String(r.Productos).trim() !== 'nan';\n  if (!esFilaProducto && !tieneId) continue; // descartar solo filas vacías (ej: Retefuente sin producto)\n  if (!lineasPorId[idActual]) lineasPorId[idActual] = [];\n  lineasPorId[idActual].push(r);\n  const nit = r.Proveedor ? String(parseInt(r.Proveedor)) : '';\n  det.push({ ID_COMPRA: idActual, COD_PRODUCTO: r.Productos !== null && r.Productos !== undefined ? String(r.Productos) : '', PRODUCTO: r.NombreProd || '', INFO: String(r.Informacion || '').slice(0, 40), CANTIDAD: num(r.Cantidad), COSTO_TOTAL: Math.round(num(r['Costo Total']) * 100) / 100, VENTA_TOTAL: Math.round(num(r['Venta Total']) * 100) / 100, NIT_PROVEEDOR: nit, TIPO_PROVEEDOR: nit === '' ? 'SIN_NIT' : (nit === NIT_PROPIO ? 'IMPORTADO' : 'LOCAL'), RETENCION_DESC: r['Retenciones Descripcion'] || '', HUMAN_REVIEW: 'PENDIENTE' });\n  if (nit && nit !== NIT_PROPIO) {\n    const k = idActual + '|' + nit;\n    provLoc[k] = (provLoc[k] || 0) + num(r['Costo Total']);\n  }\n  if (r.Id !== null && r.Id !== undefined && String(r.Id).trim() !== '') {\n    cab.push({ raw: r, id: idActual });\n  }\n}\nconst outCab = []; const outUpd = [];\nfor (const { raw: r, id } of cab) {\n  if (existentes.has(id)) {\n    // Carga diaria: el ID ya existe → actualizar campos mutables\n    outUpd.push({ json: { destino: 'CABECERA_UPD', ID_COMPRA: id, ESTADO_SYMPHONY: r.Estado || '', GESTION: r.Gestion || '', COSTO_TRANSPORTE_SYMPHONY: num(r['Costo domicilio']), ABONOS_CLIENTE: num(r['Abonos Valor']), SALDO_CLIENTE: num(r.Saldo), TRANSPORTISTA_SYMPHONY: r.Trasnportista || '' } });\n    continue;\n  }\n  const nits = new Set(lineasPorId[id].map(l => l.Proveedor ? String(parseInt(l.Proveedor)) : '').filter(Boolean));\n  const tipo = nits.size === 0 ? 'SIN_NIT' : (nits.size === 1 && nits.has(NIT_PROPIO) ? 'IMPORTADO' : (nits.has(NIT_PROPIO) ? 'MIXTO' : 'LOCAL'));\n  outCab.push({ json: { destino: 'CABECERA', ID_COMPRA: id, FECHA: r['Fecha de Creación'] || '', CLIENTE: r.Nombre || '', DOCUMENTO: r.Documento || '', CENTRO_COSTO: r['Centro de Costo'] || '', VENDEDOR: r.Vendedor || '', ESTADO_SYMPHONY: r.Estado || '', GESTION: r.Gestion || '', VALOR_VENTA: Math.round(num(r.ValorVenta) * 100) / 100, VALOR_DOMICILIO_COBRADO: num(r['Valor domicilio']), COSTO_TRANSPORTE_SYMPHONY: num(r['Costo domicilio']), TIPO_ORIGEN: tipo, TOTAL_COMPRA: num(r['Total Compra']), ABONOS_CLIENTE: num(r['Abonos Valor']), SALDO_CLIENTE: num(r.Saldo), TRANSPORTISTA_SYMPHONY: r.Trasnportista || '', ORIGEN: r.Origen || '', DESTINO: r.Destino || '', HUMAN_REVIEW: 'PENDIENTE', NOTAS: 'Cargado por WF-09' } });\n}\nconst outDet = det.filter(d => !detExistentes.has(d.ID_COMPRA)).map(d => ({ json: { destino: 'DETALLE', ...d } }));\nconst outProv = Object.entries(provLoc).filter(([k]) => !provExistentes.has(parseInt(k.split('|')[0]))).map(([k, v], i) => { const [id, nit] = k.split('|'); return { json: { destino: 'PROV_LOCAL', ID_CONTROL: 'PLP-' + Date.now().toString().slice(-6) + i, ID_COMPRA: parseInt(id), NIT_PROVEEDOR: nit, PROVEEDOR_NOMBRE: '', VALOR_COSTO: Math.round(v * 100) / 100, ESTADO_PAGO: 'PENDIENTE', HUMAN_REVIEW: 'PENDIENTE', NOTAS: 'Generado por WF-09' } }; });\nreturn [...outCab, ...outUpd, ...outDet, ...outProv];"
      },
