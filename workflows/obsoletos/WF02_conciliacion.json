      "id": "n3",
      "name": "Leer movimientos bancarios",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
