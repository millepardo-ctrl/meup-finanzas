    {
      "parameters": {
        "jsCode": "const docs = (function(){ try { return $('Leer comprobantes sin conciliar').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })().filter(d => d.CLASIFICACION !== 'COMPROBANTE_EGRESO')\n  .filter(d => ['PROCESADO','SIN_MATCH'].includes(d.ESTADO)); // SIN_MATCH se reintenta: el extracto llega al día siguiente\n// Los comprobantes de egreso (pagos a transportistas) los procesa WF-08, no este flujo.\nconst movs = (function(){ try { return $('Leer movimientos bancarios').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })();\nconst out = [];\nconst parseF = v => { if (!v) return null; if (v instanceof Date) return v;\n  if (typeof v === 'number' && v > 20000 && v < 80000) return new Date(Date.UTC(1899,11,30) + Math.round(v)*86400000);\n  const s = String(v).trim();\n  if (/^\\d+$/.test(s)) { const n = parseInt(s); if (n > 20000 && n < 80000) return new Date(Date.UTC(1899,11,30) + n*86400000); }\n  let m = s.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})/);\n  if (m) return new Date(m[3] + '-' + m[2].padStart(2,'0') + '-' + m[1].padStart(2,'0'));\n  const d2 = new Date(s.replace(' ', 'T')); return isNaN(d2) ? null : d2; };\nconst norm = s => String(s || '').toUpperCase().normalize('NFD').replace(/[^A-Z0-9 ]/g, '');\nfor (const d of docs) {\n  const val = parseFloat(d.OCR_VALOR);\n  if (!val) { out.push({ json: { ...d, match: 'ERROR', motivo: 'OCR sin valor' } }); continue; }\n  const fechaDoc = parseF(d.OCR_FECHA_PAGO);\n  // 1) Match exacto: valor igual, ingreso, fecha ±3 días, sin conciliación previa\n  let candidatos = movs.filter(m => {\n    if (m.ID_CONCILIACION) return false;\n    if (m.TIPO !== 'INGRESO') return false;\n    if (Math.abs(parseFloat(m.VALOR) - val) > 1) return false;\n    const fm = parseF(m.FECHA);\n    if (fechaDoc && fm) { const diff = Math.abs((fm - fechaDoc) / 86400000); if (diff > 3) return false; }\n    // fecha ilegible (cargas viejas con serial) → no descartar: deciden valor y desempates\n    return true;\n  });\n  // 2) Desempate por nombre de cliente\n  if (candidatos.length > 1 && d.OCR_CLIENTE) {\n    const nc = norm(d.OCR_CLIENTE).split(' ').filter(w => w.length > 3);\n    const filtered = candidatos.filter(m => nc.some(w => norm(m.TERCERO).includes(w)));\n    if (filtered.length >= 1) candidatos = filtered;\n  }\n  // Desempate adicional: la ID de compra informada por el asesor aparece en la referencia/descripción del movimiento\n  if (candidatos.length > 1 && d.ID_COMPRA_INFORMADO) {\n    const idc = String(d.ID_COMPRA_INFORMADO);\n    const byId = candidatos.filter(m => (String(m.REFERENCIA||'') + ' ' + String(m.DESCRIPCION||'') + ' ' + String(m.FACTURA_OC||'')).includes(idc));\n    if (byId.length >= 1) candidatos = byId;\n  }\n  if (candidatos.length === 1) {\n    out.push({ json: { ...d, match: 'OK', metodo: 'AUTO_VALOR_FECHA', mov: candidatos[0] } });\n  } else if (candidatos.length === 0) {\n    if (d.ESTADO === 'SIN_MATCH') continue; // ya estaba marcado: reintento silencioso, sin re-alertar\n    out.push({ json: { ...d, match: 'SIN_MATCH', motivo: 'Ningún movimiento coincide (puede que el extracto aún no esté cargado)' } });\n  } else {\n    out.push({ json: { ...d, match: 'AMBIGUO', motivo: candidatos.length + ' movimientos candidatos', candidatos: candidatos.map(c => c.ID_MOV).join(', ') } });\n  }\n}\nreturn out;"
      },
