      "parameters": {
        "jsCode": "// Si fue ABONO, crear nueva fila PENDIENTE por el saldo y actualizar estado de la solicitud\nconst j = $('¿Resultado?').item.json;\nconst items = [];\nconst saldo = parseFloat(j.pago.VALOR) - j.valorPagado;\nif (j.esAbono && saldo > 1) {\n  items.push({ json: { crearSaldo: true, fila: {\n    ID_PAGO: 'TRP-' + Date.now().toString().slice(-9),\n    ID_SOLICITUD: j.pago.ID_SOLICITUD,\n    ID_COMPRA: j.pago.ID_COMPRA,\n    TRANSPORTISTA: j.pago.TRANSPORTISTA,\n    CEDULA: j.pago.CEDULA,\n    TIPO: 'SALDO',\n    VALOR: saldo,\n    MEDIO_PAGO: j.pago.MEDIO_PAGO,\n    ESTADO: 'PENDIENTE',\n    NOTAS: 'Saldo tras abono ' + j.pago.ID_PAGO\n  }, estadoSolicitud: 'PARCIAL', j }});\n} else {\n  items.push({ json: { crearSaldo: false, estadoSolicitud: 'PAGADO', j }});\n}\nreturn items;"
      },
