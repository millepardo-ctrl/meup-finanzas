    {
      "parameters": {
        "jsCode": "const docs = (function(){ try { return $('Leer comprobantes').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })()\n  .filter(d => d.CLASIFICACION === 'COMPROBANTE_EGRESO' && ['PROCESADO','SIN_MATCH','REVISAR'].includes(d.ESTADO));\nconst pagos = (function(){ try { return $('Leer TRANSPORTES_PAGOS').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })();\nconst sols = (function(){ try { return $('Leer TRANSPORTES_SOLICITUDES').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })();\nconst movs = (function(){ try { return $('Leer BANCOS_MOV').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })();\nconst parseF = v => { if (!v) return null; if (v instanceof Date) return v;\n  if (typeof v === 'number' && v > 20000 && v < 80000) return new Date(Date.UTC(1899,11,30) + Math.round(v)*86400000);\n  const s = String(v).trim();\n  if (/^\\d+$/.test(s)) { const n = parseInt(s); if (n > 20000 && n < 80000) return new Date(Date.UTC(1899,11,30) + n*86400000); }\n  let m = s.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})/);\n  if (m) return new Date(m[3] + '-' + m[2].padStart(2,'0') + '-' + m[1].padStart(2,'0'));\n  const d2 = new Date(s.replace(' ', 'T')); return isNaN(d2) ? null : d2; };\nconst norm = s => String(s || '').toUpperCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^A-Z0-9 ]/g,'');\nconst out = [];\nfor (const d of docs) {\n  const val = parseFloat(d.OCR_VALOR);\n  if (!val) { out.push({ json: { accion: 'ERROR', doc: d, motivo: 'OCR sin valor' } }); continue; }\n  const pend = pagos.filter(p => p.ESTADO === 'PENDIENTE');\n  // Score: valor (obligatorio ±1) + nombre transportista + teléfono en referencia OCR\n  const neto = p2 => { const v = parseFloat(p2.PAGO_NETO); return isNaN(v) || !v ? parseFloat(p2.VALOR) : v; };\n  // El comprobante muestra el NETO pagado (bruto - retefuente 1%); cruzar contra neto o bruto\n  let candidatos = pend.filter(p => Math.abs(neto(p) - val) <= 1 || Math.abs(parseFloat(p.VALOR) - val) <= 1);\n  let esAbono = false;\n  if (candidatos.length === 0) {\n    // Abono parcial: valor menor al pendiente, desempatar por nombre/teléfono\n    candidatos = pend.filter(p => val < neto(p));\n    esAbono = true;\n  }\n  if (candidatos.length > 1) {\n    const ref = norm(d.OCR_REFERENCIA + ' ' + d.OCR_CLIENTE);\n    const byPhone = candidatos.filter(p => {\n      const sol = sols.find(s => s.ID_SOLICITUD === p.ID_SOLICITUD) || {};\n      return sol.TELEFONO && ref.includes(String(sol.TELEFONO));\n    });\n    if (byPhone.length >= 1) candidatos = byPhone;\n    else {\n      const byName = candidatos.filter(p => norm(p.TRANSPORTISTA).split(' ').filter(w => w.length > 3).some(w => ref.includes(w)));\n      if (byName.length >= 1) candidatos = byName;\n    }\n  }\n  if (candidatos.length !== 1) {\n      if (candidatos.length === 0 && d.ESTADO === 'SIN_MATCH') continue; // reintento silencioso\n      if (candidatos.length > 1 && d.ESTADO === 'AMBIGUO') continue; // ya alertado, espera revisión humana\n      out.push({ json: { accion: candidatos.length === 0 ? 'SIN_MATCH_TRANSPORTE' : 'AMBIGUO', doc: d, motivo: candidatos.length + ' candidatos en TRANSPORTES_PAGOS' } }); continue;\n    }\n  const p = candidatos[0];\n  // Anti-duplicado nivel comprobante: ¿ya hay un pago PAGADO con este ID_DOC_WA o mismo valor+transportista+fecha?\n  const yaPagado = pagos.find(x => x.ESTADO === 'PAGADO' && (x.ID_DOC_WA === d.ID_DOC || (Math.abs(parseFloat(x.VALOR)-val)<=1 && norm(x.TRANSPORTISTA)===norm(p.TRANSPORTISTA) && x.FECHA_PAGO === d.OCR_FECHA_PAGO)));\n  if (yaPagado) {\n    out.push({ json: { accion: 'DUPLICADO', doc: d, pago: p, motivo: 'Ya existe pago ' + yaPagado.ID_PAGO + ' con mismo valor/transportista/fecha' } });\n    continue;\n  }\n  // Anti-duplicado nivel banco: ¿existe ya el egreso real en el extracto?\n  const movReal = movs.find(m => { if (m.ID_CONCILIACION) return false; const mv = parseFloat(m.VALOR); if (!(mv <= -val + 1 && mv >= -val - 1) || m.TIPO !== 'EGRESO') return false; const fd = parseF(d.OCR_FECHA_PAGO), fm2 = parseF(m.FECHA); if (fd && fm2) return Math.abs((fm2 - fd) / 86400000) <= 3; return true; });\n  const sol = sols.find(s => s.ID_SOLICITUD === p.ID_SOLICITUD) || {};\n  out.push({ json: { accion: 'MATCH', doc: d, pago: p, sol, esAbono, valorPagado: val, movRealExistente: movReal ? movReal.ID_MOV : '' } });\n}\nreturn out;"
      },
