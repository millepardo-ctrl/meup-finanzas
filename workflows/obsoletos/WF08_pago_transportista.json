      "parameters": {
        "jsCode": "// Registrar el egreso en BANCOS_MOV evitando duplicados:\n// si el egreso real ya está en el extracto, solo lo vinculamos; si no, creamos fila proyectada.\nconst d = $('Gestionar abono / saldo').item.json.j;\nif (d.movRealExistente) {\n  return [{ json: { modo: 'VINCULAR', ID_MOV: d.movRealExistente, idPago: d.pago.ID_PAGO } }];\n}\nreturn [{ json: { modo: 'CREAR', fila: {\n  ID_MOV: 'MOV-' + Date.now().toString().slice(-9),\n  FECHA: d.doc.OCR_FECHA_PAGO,\n  CUENTA: d.pago.CUENTA_ORIGEN || 'BC-CTE-3762',\n  DESCRIPCION: 'Pago transportista ' + d.pago.TRANSPORTISTA,\n  REFERENCIA: d.pago.ID_PAGO,\n  MONEDA: 'COP',\n  VALOR: -Math.abs(d.valorPagado), // = neto real que salió del banco según el comprobante\n  TIPO: 'EGRESO',\n  CATEGORIA: 'TRANSPORTE',\n  DETALLE: 'Cta cobro ' + (d.sol.CUENTA_COBRO || '') + ' Rem ' + (d.sol.REMISION || '') + ' via ' + d.pago.MEDIO_PAGO,\n  FACTURA_OC: d.pago.ID_COMPRA,\n  TERCERO: d.pago.TRANSPORTISTA + ' CC ' + d.pago.CEDULA,\n  ID_CONCILIACION: d.pago.ID_PAGO,\n  ESTADO_CONTABLE: 'PENDIENTE',\n  ORIGEN: 'TRANSPORTE_APP'\n}, idPago: d.pago.ID_PAGO }}];"
      },
