    {
      "parameters": {
        "jsCode": "// Payload esperado: { id_import, tipo_pago, fecha, moneda, valor, trm, cuenta_origen, comprobante, notas }\nconst b = $json.body;\nconst req = ['id_import','tipo_pago','fecha','valor'];\nfor (const k of req) { if (!b[k]) throw new Error('Falta el campo: ' + k); }\nconst tiposValidos = ['INVOICE','NEGINTCOMEX','NAVIERA','IVA_DIM','OTRO'];\nif (!tiposValidos.includes(b.tipo_pago)) throw new Error('tipo_pago debe ser: ' + tiposValidos.join('|'));\nconst valor = parseFloat(b.valor);\nconst trm = parseFloat(b.trm) || '';\nreturn [{ json: {\n  ID_PAGO: 'PGI-' + Date.now().toString().slice(-8),\n  ID_IMPORT: b.id_import,\n  TIPO_PAGO: b.tipo_pago,\n  FECHA: b.fecha,\n  MONEDA: b.moneda || 'USD',\n  VALOR: valor,\n  TRM_PAGO: trm,\n  VALOR_COP: (b.moneda === 'COP') ? valor : (trm ? Math.round(valor * trm) : ''),\n  CUENTA_ORIGEN: b.cuenta_origen || '',\n  COMPROBANTE_SIIGO: b.comprobante || '',\n  NOTAS: b.notas || ''\n}}];"
      },
      "id": "n2",
      "name": "Validar y estructurar pago",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
