    {
      "parameters": {
        "jsCode": "// Motor de conciliación de EGRESOS GENERALES (grupo Contabilidad)\n// Cruza comprobantes de egreso ↔ movimientos bancarios negativos, y pagos a proveedores locales por OC.\nconst docs = (function(){ try { return $('Leer comprobantes').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })()\n  .filter(d => d.CLASIFICACION === 'COMPROBANTE_EGRESO' && d.GRUPO_ORIGEN === 'CONTABILIDAD' && ['PROCESADO','SIN_MATCH'].includes(d.ESTADO));\nconst movs = (function(){ try { return $('Leer BANCOS_MOV').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })();\nconst tpagos = (function(){ try { return $('Leer TRANSPORTES_PAGOS').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })();\nconst provs = (function(){ try { return $('Leer PROVEEDORES_LOCALES_PAGOS').all().map(i => i.json).filter(x => x && Object.keys(x).length); } catch(e) { return []; } })();\nconst todos = (function(){ try { return $('Leer comprobantes').all().map(i => i.json).filter(x => x && x.ID_DOC); } catch(e) { return []; } })();\nconst soportes = todos.filter(x => ['FACTURA','ORDEN_COMPRA'].includes(x.CLASIFICACION) && ['REVISAR','ARCHIVO','PROCESADO'].includes(x.ESTADO));\nconst out = [];\nconst parseF = v => { if (!v) return null; if (v instanceof Date) return v;\n  if (typeof v === 'number' && v > 20000 && v < 80000) return new Date(Date.UTC(1899,11,30) + Math.round(v)*86400000);\n  const s = String(v).trim();\n  if (/^\\d+$/.test(s)) { const n = parseInt(s); if (n > 20000 && n < 80000) return new Date(Date.UTC(1899,11,30) + n*86400000); }\n  let m = s.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})/);\n  if (m) return new Date(m[3] + '-' + m[2].padStart(2,'0') + '-' + m[1].padStart(2,'0'));\n  const d2 = new Date(s.replace(' ', 'T')); return isNaN(d2) ? null : d2; };\nconst neto = p => { const v = parseFloat(p.PAGO_NETO); return isNaN(v) || !v ? parseFloat(p.VALOR) : v; };\nfor (const d of docs) {\n  const val = parseFloat(d.OCR_VALOR);\n  if (!val) { if (d.ESTADO !== 'SIN_MATCH') out.push({ json: { accion: 'ERROR', doc: d, motivo: 'OCR sin valor' } }); continue; }\n  // Los soportes de transporte también llegan a Contabilidad: si coincide con un pago de transporte pendiente, es territorio de WF-08\n  const esTransporte = tpagos.some(p => p.ESTADO === 'PENDIENTE' && (Math.abs(neto(p) - val) <= 1 || Math.abs(parseFloat(p.VALOR) - val) <= 1));\n  if (esTransporte || d.CATEGORIA_GASTO === 'TRANSPORTE') continue; // lo procesa WF-08\n  // Match contra egresos bancarios: valor exacto (±1), fecha ±3 días, sin conciliación previa\n  const fechaDoc = parseF(d.OCR_FECHA_PAGO);\n  let candidatos = movs.filter(m => {\n    if (m.ID_CONCILIACION) return false;\n    const mv = parseFloat(m.VALOR);\n    if (isNaN(mv) || mv >= 0) return false;\n    if (Math.abs(Math.abs(mv) - val) > 1) return false;\n    const fm = parseF(m.FECHA);\n    if (fechaDoc && fm) { const diff = Math.abs((fm - fechaDoc) / 86400000); if (diff > 3) return false; }\n    return true;\n  });\n  // Desempate por OC/ID en referencia del extracto, luego por nombre del beneficiario\n  const norm = s => String(s || '').toUpperCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n  if (candidatos.length > 1 && d.OC_NUM) {\n    const byOC = candidatos.filter(m => (String(m.REFERENCIA||'') + ' ' + String(m.DESCRIPCION||'')).includes(String(d.OC_NUM).replace(/\\D/g,'')));\n    if (byOC.length >= 1) candidatos = byOC;\n  }\n  if (candidatos.length > 1 && d.OCR_CLIENTE) {\n    const toks = norm(d.OCR_CLIENTE).split(' ').filter(w => w.length > 3);\n    const byName = candidatos.filter(m => toks.some(w => norm(m.DESCRIPCION + ' ' + m.TERCERO).includes(w)));\n    if (byName.length >= 1) candidatos = byName;\n  }\n  if (candidatos.length !== 1) {\n    if (candidatos.length === 0 && d.ESTADO === 'SIN_MATCH') continue; // reintento silencioso: el extracto llega al día siguiente\n    out.push({ json: { accion: candidatos.length === 0 ? 'SIN_MATCH' : 'AMBIGUO', doc: d, motivo: candidatos.length + ' movimientos candidatos' } });\n    continue;\n  }\n  // ¿Este egreso paga una compra a proveedor local? (por OC = ID_COMPRA y valor)\n  const oc = String(d.OC_NUM || d.ID_COMPRA_INFORMADO || '').replace(/\\D/g,'');\n  let provLocal = null;\n  if (oc) {\n    provLocal = provs.find(p => String(p.ID_COMPRA) === oc && p.ESTADO_PAGO !== 'PAGADO' && Math.abs(parseFloat(p.VALOR_COSTO) - val) <= Math.max(1, parseFloat(p.VALOR_COSTO) * 0.02));\n    if (!provLocal) provLocal = provs.find(p => String(p.ID_COMPRA) === oc && p.ESTADO_PAGO !== 'PAGADO'); // abono parcial\n  }\n  // ¿Llegó junto a una FACTURA u ORDEN DE COMPRA? (mismo remitente, ±60 min, mismo valor o misma OC)\n  const tsDoc = (parseF(d.FECHA_RECIBIDO) || new Date()).getTime();\n  const difH = s2 => { const t2 = parseF(s2.FECHA_RECIBIDO); return t2 ? Math.abs(t2.getTime() - tsDoc) / 3600000 : 9999; };\n  const soporte =\n    soportes.find(s2 => oc && String(s2.OC_NUM || '').replace(/\\D/g, '') === oc && difH(s2) <= 168) || // misma OC: hasta 7 días, cualquier remitente\n    soportes.find(s2 => s2.REMITENTE_WA === d.REMITENTE_WA && s2.OCR_VALOR && String(s2.OCR_VALOR) === String(d.OCR_VALOR) && difH(s2) <= 24) || // mismo valor + remitente: 24 h\n    soportes.find(s2 => s2.OCR_VALOR && String(s2.OCR_VALOR) === String(d.OCR_VALOR) && difH(s2) <= 1) || null; // mismo valor, 1 h\n  const catFinal = (soporte && soporte.CLASIFICACION === 'ORDEN_COMPRA') ? 'COMPRA_PROVEEDOR' : (d.CATEGORIA_GASTO || (soporte && soporte.CATEGORIA_GASTO) || 'GASTO_GENERAL');\n  const tercFinal = (soporte && soporte.OCR_CLIENTE) || d.OCR_CLIENTE || '';\n  const ocFinal = (soporte && soporte.OC_NUM) || d.OC_NUM || '';\n  out.push({ json: { accion: 'MATCH', doc: d, mov: candidatos[0], provLocal: provLocal || null,\n    esAbonoProveedor: provLocal ? val < parseFloat(provLocal.VALOR_COSTO) - 1 : false, valor: val,\n    catFinal, tercFinal, ocFinal, soporte: soporte || null } });\n  if (soporte) out.push({ json: { accion: 'CERRAR_SOPORTE', soporteId: soporte.ID_DOC, pagoId: d.ID_DOC } });\n}\nreturn out;"
      },
